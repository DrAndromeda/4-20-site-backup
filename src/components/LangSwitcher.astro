---
import { LOCALES, LANG_META, type Lang } from '../i18n/ui';
import { localePath, useTranslations } from '../i18n/utils';
interface Props { lang: Lang; path: string; langs?: Lang[]; variant?: 'menu' | 'chips' }
const { lang, path, langs = [...LOCALES], variant = 'menu' } = Astro.props;
const t = useTranslations(lang);
const href = (l: Lang) => localePath(l, langs.includes(l) ? path : '/');
---
{variant === 'menu' ? (
  <details class="lm" data-lang-menu>
    <summary aria-label={t('nav.language')}>
      <svg class="lm__globe" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.6 2.700 3.900 5.700 3.900 9s-1.300 6.300-3.900 9c-2.600-2.700-3.900-5.700-3.900-9s1.300-6.300 3.900-9z"/></svg>
      <span>{LANG_META[lang].label}</span>
      <svg class="lm__chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
    </summary>
    <ul class="lm__list">
      {LOCALES.map((l) => (
        <li>
          <a href={href(l)} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>
            <span class="lm__code">{LANG_META[l].label}</span>
            <span class="lm__name">{LANG_META[l].name}</span>
            {l === lang && <svg class="lm__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5 9-10"/></svg>}
          </a>
        </li>
      ))}
    </ul>
  </details>
) : (
  <nav class="chips" aria-label={t('nav.language')}>
    {LOCALES.map((l) => (
      <a href={href(l)} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>{LANG_META[l].name}</a>
    ))}
  </nav>
)}
<style>
  .lm { position: relative; }
  .lm summary { list-style: none; cursor: pointer; display: inline-flex; align-items: center; gap: 7px; height: 40px; padding: 0 12px 0 11px; border: 1px solid var(--border); border-radius: 999px; background: var(--surface); color: var(--text); font: 700 .85rem/1 var(--font-head); letter-spacing: .04em; transition: border-color .15s, background .15s; user-select: none; }
  .lm summary::-webkit-details-marker { display: none; }
  .lm summary:hover, .lm[open] summary { border-color: var(--brand); background: var(--bg-alt); }
  .lm__globe { width: 18px; height: 18px; color: var(--brand-dark); }
  @media (prefers-color-scheme: dark) { .lm__globe { color: var(--brand); } }
  .lm__chev { width: 14px; height: 14px; transition: transform .2s; }
  .lm[open] .lm__chev { transform: rotate(180deg); }
  .lm__list { position: absolute; right: 0; top: calc(100% + 8px); z-index: 130; min-width: 190px; margin: 0; padding: 6px; list-style: none; background: var(--surface); border: 1px solid var(--border); border-radius: 16px; box-shadow: 0 18px 40px rgb(0 0 0 / 22%); animation: lm-in .16s ease; }
  @keyframes lm-in { from { opacity: 0; transform: translateY(-6px); } }
  .lm__list a { display: flex; align-items: center; gap: 10px; min-height: 44px; padding: 0 12px; border-radius: 10px; color: var(--text); text-decoration: none; }
  .lm__list a:hover { background: var(--bg-alt); color: var(--text); }
  .lm__list a[aria-current] { background: color-mix(in srgb, var(--brand) 14%, transparent); }
  .lm__code { width: 28px; font: 800 .75rem/1 var(--font-head); letter-spacing: .06em; color: var(--text-2); }
  .lm__name { font-weight: 600; flex: 1; }
  .lm__check { width: 16px; height: 16px; color: var(--brand-dark); }

  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chips a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 16px; border: 1px solid var(--border); border-radius: 999px; color: var(--text); text-decoration: none; font-weight: 600; background: var(--surface); }
  .chips a[aria-current] { background: var(--brand); border-color: var(--brand); color: var(--brand-ink); }
</style>
