---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
interface Props { lang: Lang }
const t = useTranslations(Astro.props.lang);
---
<!-- Progressive enhancement: hidden unless JS finds no stored confirmation. Content stays crawlable. -->
<dialog class="age" id="age-gate" aria-labelledby="age-title" data-denied={t('age.denied')}>
  <div class="age__box">
    <div class="age__badge" aria-hidden="true">18+</div>
    <h2 id="age-title">{t('age.title')}</h2>
    <p>{t('age.text')}</p>
    <div class="age__actions">
      <button class="btn" type="button" data-age-yes>{t('age.yes')}</button>
      <button class="btn btn--ghost" type="button" data-age-no>{t('age.no')}</button>
    </div>
    <p class="age__denied" data-age-msg hidden></p>
  </div>
</dialog>
<style>
  .age { border: 0; padding: 0; background: transparent; max-width: 100vw; max-height: 100dvh; width: 100%; height: 100%; }
  .age::backdrop { background: radial-gradient(600px 400px at 50% 40%, rgb(40 120 20 / 35%), transparent 70%), rgb(6 12 6 / 86%); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); }
  .age[open] { display: grid; place-items: center; padding: var(--gutter); }
  .age__box { position: relative; overflow: hidden; width: min(440px, 100%); background: var(--surface); color: var(--text); border: 1px solid var(--border); border-radius: 28px; padding: 40px 32px 32px; text-align: center; box-shadow: var(--shadow-lg); animation: age-in .6s var(--ease) both; }
  .age__box::before { content: ''; position: absolute; inset: 0 0 auto; height: 160px; z-index: 0; background: radial-gradient(260px 140px at 50% 0%, var(--glow), transparent 70%); pointer-events: none; }
  .age__box > * { position: relative; }
  @keyframes age-in { from { opacity: 0; transform: translateY(20px) scale(.96); } }
  .age__badge { width: 84px; height: 84px; margin: 0 auto 20px; display: grid; place-items: center; border-radius: 50%; background: radial-gradient(circle at 30% 25%, var(--brand-light), var(--brand) 55%, var(--brand-dark)); color: var(--brand-ink); font: 700 1.6rem/1 var(--font-mono); letter-spacing: -.02em; box-shadow: 0 0 0 8px color-mix(in srgb, var(--brand) 14%, transparent), 0 12px 30px -6px color-mix(in srgb, var(--brand) 70%, transparent); }
  .age__box h2 { font-size: 1.6rem; }
  .age__box p { color: var(--text-2); }
  .age__actions { display: grid; gap: 10px; margin-top: 24px; }
  .age__actions .btn { width: 100%; }
  .age__denied { margin-top: 16px; color: #d9453b; font-weight: 600; }
</style>
<script>
  const KEY = 'age-ok';
  const dlg = document.getElementById('age-gate') as HTMLDialogElement | null;
  let ok = false;
  try { ok = localStorage.getItem(KEY) === '1'; } catch {}
  if (dlg && !ok) {
    dlg.showModal();
    dlg.addEventListener('cancel', (e) => e.preventDefault()); // Esc must not bypass the gate
    dlg.querySelector('[data-age-yes]')?.addEventListener('click', () => {
      try { localStorage.setItem(KEY, '1'); } catch {}
      dlg.close();
    });
    dlg.querySelector('[data-age-no]')?.addEventListener('click', () => {
      const msg = dlg.querySelector<HTMLElement>('[data-age-msg]')!;
      msg.textContent = dlg.dataset.denied ?? '';
      msg.hidden = false;
      dlg.querySelectorAll('button').forEach((b) => ((b as HTMLButtonElement).disabled = true));
    });
  }
</script>
