---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
interface Props { lang: Lang; items: { q: string; a: string }[] }
const { lang, items } = Astro.props;
const t = useTranslations(lang);
---
{items.length > 0 && (
  <section class="faq" aria-labelledby="faq-h">
    <h2 id="faq-h">{t('ui.faq')}</h2>
    <div class="faq__list">
      {items.map((it, i) => (
        <details open={i === 0}>
          <summary><span class="faq__q">{it.q}</span><span class="faq__ic" aria-hidden="true"></span></summary>
          <div class="faq__a"><p>{it.a}</p></div>
        </details>
      ))}
    </div>
  </section>
)}
<style>
  .faq { margin-block: 56px; max-width: 74ch; }
  .faq h2 { margin-bottom: 20px; }
  .faq__list { display: grid; gap: 10px; }
  details { border: 1px solid var(--border); border-radius: 16px; background: var(--surface); transition: border-color .25s, box-shadow .25s, background .25s; }
  details:hover { border-color: var(--border-strong); }
  details[open] { border-color: color-mix(in srgb, var(--brand) 40%, var(--border)); box-shadow: var(--shadow); }
  details::details-content { block-size: 0; overflow: hidden; transition: block-size .35s var(--ease), content-visibility .35s allow-discrete; }
  details[open]::details-content { block-size: auto; }
  summary { cursor: pointer; list-style: none; display: flex; justify-content: space-between; gap: 16px; align-items: center; min-height: 56px; padding: 14px 18px 14px 20px; font: 700 1.02rem/1.4 var(--font-head); letter-spacing: -.01em; border-radius: 16px; }
  summary::-webkit-details-marker { display: none; }
  .faq__ic { position: relative; flex: none; width: 30px; height: 30px; border-radius: 50%; background: var(--bg-alt); border: 1px solid var(--border); transition: background .25s, border-color .25s, transform .35s var(--ease); }
  .faq__ic::before, .faq__ic::after { content: ''; position: absolute; left: 50%; top: 50%; width: 12px; height: 2px; margin: -1px 0 0 -6px; border-radius: 2px; background: var(--text-2); transition: transform .35s var(--ease), background .25s; }
  .faq__ic::after { transform: rotate(90deg); }
  summary:hover .faq__ic { border-color: var(--brand); }
  details[open] .faq__ic { background: var(--brand); border-color: var(--brand); transform: rotate(180deg); }
  details[open] .faq__ic::before, details[open] .faq__ic::after { background: var(--brand-ink); }
  details[open] .faq__ic::after { transform: rotate(0); }
  .faq__a { padding: 0 20px 18px; }
  .faq__a p { margin: 0; color: var(--text-2); line-height: 1.7; }
</style>
