---
import type { Lang } from '../i18n/ui';
import { localePath, useTranslations } from '../i18n/utils';
import LangSwitcher from './LangSwitcher.astro';
import Logo from './Logo.astro';
interface Props { lang: Lang; path: string; langs?: Lang[] }
const { lang, path, langs } = Astro.props;
const t = useTranslations(lang);
const nav = [
  ['about', '/about/'],
  ['cannabinoids', '/cannabinoids/'],
  ['terpenes', '/terpenes/'],
  ['growing', '/growing/'],
  ['use', '/consumption/'],
  ['law', '/law/'],
  ['tools', '/tools/'],
  ['faq', '/faq/'],
] as const;
---
<header class="hdr">
  <div class="container hdr__in">
    <Logo href={localePath(lang)} />

    <div class="hdr__panel" id="main-nav" data-panel>
      <nav class="nav" aria-label={t('nav.menu')}>
        {nav.map(([key, href]) => (
          <a href={localePath(lang, href)} aria-current={path === href ? 'page' : path.startsWith(href) ? 'true' : undefined}>{t(`nav.${key}`)}</a>
        ))}
      </nav>
      <div class="hdr__chips">
        <p class="hdr__chips-title">{t('nav.language')}</p>
        <LangSwitcher lang={lang} path={path} langs={langs} variant="chips" />
      </div>
    </div>

    <div class="hdr__right">
      <button class="tt" type="button" data-theme-toggle aria-label={t('ui.theme')} title={t('ui.theme')}>
        <svg class="tt__sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4L6 18M18 6l1.4-1.4"/></svg>
        <svg class="tt__moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
      </button>
      <div class="hdr__lang"><LangSwitcher lang={lang} path={path} langs={langs} variant="menu" /></div>
      <button class="burger" type="button" aria-expanded="false" aria-controls="main-nav" data-burger>
        <span class="sr-only">{t('nav.menu')}</span>
        <span class="burger__bars" aria-hidden="true"><i></i><i></i><i></i></span>
      </button>
    </div>
  </div>
</header>

<style>
  .hdr { position: sticky; top: 0; z-index: 100; view-transition-name: site-header; background: color-mix(in srgb, var(--bg) 78%, transparent); backdrop-filter: saturate(1.6) blur(16px); -webkit-backdrop-filter: saturate(1.6) blur(16px); border-bottom: 1px solid transparent; transition: border-color .25s, box-shadow .25s, background .25s; }
  :global(.hdr.is-scrolled) { border-bottom-color: var(--border); background: color-mix(in srgb, var(--bg) 86%, transparent); box-shadow: 0 8px 30px -12px rgb(0 0 0 / 22%); }
  .hdr__in { max-width: 1320px; display: grid; grid-template-columns: auto 1fr auto; align-items: center; min-height: var(--header-h); gap: 20px; }

  /* Desktop nav: one rounded capsule, centred */
  .hdr__panel { display: flex; justify-content: center; min-width: 0; }
  .hdr__chips { display: none; }
  .nav { display: flex; gap: 2px; padding: 4px; border: 1px solid var(--border); border-radius: 999px; background: color-mix(in srgb, var(--surface) 60%, transparent); box-shadow: var(--shadow-sm); }
  .nav a { display: inline-flex; align-items: center; min-height: 38px; padding: 0 13px; white-space: nowrap; border-radius: 999px; color: var(--text-2); text-decoration: none; font: 600 .875rem/1 var(--font-head); transition: background .18s, color .18s, box-shadow .18s; }
  .nav a:hover { color: var(--text); background: var(--bg-alt); text-decoration: none; }
  .nav a[aria-current] { background: var(--brand); color: var(--brand-ink); box-shadow: inset 0 1px 0 rgb(255 255 255 / 35%), 0 4px 14px -4px color-mix(in srgb, var(--brand) 70%, transparent); }

  /* Theme toggle */
  .tt { position: relative; width: 44px; height: 44px; display: grid; place-items: center; border: 1px solid var(--border); border-radius: 50%; background: var(--surface); color: var(--text-2); cursor: pointer; transition: border-color .2s, color .2s, background .2s; }
  .tt:hover { border-color: var(--brand); color: var(--text); }
  .tt svg { grid-area: 1 / 1; width: 19px; height: 19px; transition: transform .5s var(--ease-spring), opacity .3s; }
  .tt__sun { opacity: 0; transform: rotate(-90deg) scale(.5); }
  :global(:root[data-theme='dark']) .tt__sun { opacity: 1; transform: none; }
  :global(:root[data-theme='dark']) .tt__moon { opacity: 0; transform: rotate(90deg) scale(.5); }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .tt__sun { opacity: 1; transform: none; }
    :global(:root:not([data-theme='light'])) .tt__moon { opacity: 0; transform: rotate(90deg) scale(.5); }
  }

  .hdr__right { display: flex; align-items: center; gap: 10px; }
  .burger { display: none; }

  /* Tablet / phone: burger + full-width sheet */
  @media (max-width: 1179px) {
    .hdr__in { grid-template-columns: 1fr auto; }
    .hdr__lang { display: none; }
    .burger { display: inline-grid; place-items: center; width: 44px; height: 44px; border: 1px solid var(--border); border-radius: 50%; background: var(--surface); color: var(--text); cursor: pointer; transition: border-color .15s, background .15s; }
    .burger:hover { border-color: var(--brand); }
    .burger__bars { position: relative; width: 20px; height: 14px; }
    .burger__bars i { position: absolute; left: 0; width: 100%; height: 2px; border-radius: 2px; background: currentColor; transition: transform .25s, opacity .2s, top .25s; }
    .burger__bars i:nth-child(1) { top: 0; } .burger__bars i:nth-child(2) { top: 6px; } .burger__bars i:nth-child(3) { top: 12px; }
    .burger[aria-expanded='true'] { background: var(--brand); border-color: var(--brand); color: var(--brand-ink); }
    .burger[aria-expanded='true'] i:nth-child(1) { top: 6px; transform: rotate(45deg); }
    .burger[aria-expanded='true'] i:nth-child(2) { opacity: 0; }
    .burger[aria-expanded='true'] i:nth-child(3) { top: 6px; transform: rotate(-45deg); }

    .hdr__panel { position: absolute; inset: var(--header-h) 0 auto 0; flex-direction: column; justify-content: flex-start; gap: 20px; padding: 12px var(--gutter) 28px; background: var(--bg); border-bottom: 1px solid var(--border); box-shadow: 0 24px 40px rgb(0 0 0 / 25%); max-height: calc(100dvh - var(--header-h)); overflow-y: auto; display: none; }
    .hdr__panel.is-open { display: flex; animation: sheet-in .28s var(--ease); }
    .hdr__panel.is-open .nav a { animation: fade-up .45s var(--ease) both; }
    .hdr__panel.is-open .nav a:nth-child(2) { animation-delay: 30ms; } .hdr__panel.is-open .nav a:nth-child(3) { animation-delay: 60ms; }
    .hdr__panel.is-open .nav a:nth-child(4) { animation-delay: 90ms; } .hdr__panel.is-open .nav a:nth-child(5) { animation-delay: 120ms; }
    .hdr__panel.is-open .nav a:nth-child(6) { animation-delay: 150ms; } .hdr__panel.is-open .nav a:nth-child(7) { animation-delay: 180ms; }
    .hdr__panel.is-open .nav a:nth-child(8) { animation-delay: 210ms; }
    @keyframes sheet-in { from { opacity: 0; transform: translateY(-8px); } }
    .nav { flex-direction: column; gap: 0; padding: 0; border: 0; background: transparent; border-radius: 0; }
    .nav a { min-height: 54px; padding: 0 6px; border-radius: 0; border-bottom: 1px solid var(--border); font-size: 1.1rem; color: var(--text); justify-content: space-between; background: transparent; box-shadow: none; }
    .nav a::after { content: '›'; color: var(--text-2); font-size: 1.4rem; }
    .nav a:hover { background: transparent; box-shadow: none; color: var(--accent-text); }
    .nav a[aria-current] { background: transparent; color: var(--text); box-shadow: none; position: relative; font-weight: 800; }
    .nav a[aria-current]::before { content: ''; position: absolute; left: -6px; top: 12px; bottom: 12px; width: 4px; border-radius: 2px; background: var(--brand); }
    .hdr__chips { display: block; }
    .hdr__chips-title { margin: 0 0 10px; font: 700 .75rem/1 var(--font-head); letter-spacing: .12em; text-transform: uppercase; color: var(--text-2); }
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-burger]');
  const panel = document.querySelector<HTMLElement>('[data-panel]');
  const set = (open: boolean) => {
    btn?.setAttribute('aria-expanded', String(open));
    panel?.classList.toggle('is-open', open);
  };
  btn?.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
  panel?.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) set(false); });
  // language dropdown: close on outside click / Esc
  const menu = document.querySelector<HTMLDetailsElement>('[data-lang-menu]');
  document.addEventListener('click', (e) => { if (menu?.open && !menu.contains(e.target as Node)) menu.open = false; });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') { set(false); if (menu) menu.open = false; } });
  // theme toggle: flips light/dark, remembers the choice, circular reveal where supported
  const tt = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  tt?.addEventListener('click', () => {
    const root = document.documentElement;
    const cur = root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    const next = cur === 'dark' ? 'light' : 'dark';
    const apply = () => {
      root.dataset.theme = next;
      // keep the browser UI colour in sync with the chosen theme, not just the OS scheme
      document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]').forEach((m) => { m.content = next === 'dark' ? '#0a0f0a' : '#fafcf9'; });
      try { localStorage.setItem('theme', next); } catch {}
    };
    const doc = document as Document & { startViewTransition?: (cb: () => void) => { finished: Promise<void> } };
    if (!doc.startViewTransition || matchMedia('(prefers-reduced-motion: reduce)').matches) return apply();
    const r = tt.getBoundingClientRect();
    root.style.setProperty('--vx', `${r.left + r.width / 2}px`);
    root.style.setProperty('--vy', `${r.top + r.height / 2}px`);
    root.classList.add('theme-vt');
    doc.startViewTransition(apply).finished.finally(() => root.classList.remove('theme-vt'));
  });
  // leaving the mobile breakpoint: reset state
  matchMedia('(min-width: 1180px)').addEventListener('change', (e) => { if (e.matches) set(false); });
</script>
