---
/** Static month grid with stage bars (CSS grid, no JS). start/end are month numbers 1–12; end < start wraps over the new year. */
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
interface Stage { label: string; start: number; end: number; color?: string }
interface Props { lang: Lang; caption: string; stages: Stage[] }
const { lang, caption, stages } = Astro.props;
const t = useTranslations(lang);
const months = Array.from({ length: 12 }, (_, i) => new Intl.DateTimeFormat(lang, { month: 'short' }).format(new Date(2024, i, 1)));
const covers = (s: Stage, m: number) => (s.start <= s.end ? m >= s.start && m <= s.end : m >= s.start || m <= s.end);
---
<figure class="gc">
  <figcaption>{caption} <span>· {t('ui.hemisphere')}</span></figcaption>
  <div class="gc__scroll" role="region" aria-label={caption} tabindex="0">
    <table>
      <thead>
        <tr><td></td>{months.map((m) => <th scope="col">{m}</th>)}</tr>
      </thead>
      <tbody>
        {stages.map((s) => (
          <tr>
            <th scope="row">{s.label}</th>
            {months.map((_, i) => {
              const m = i + 1, on = covers(s, m);
              const st = on && (m === 1 || !covers(s, m - 1)), en = on && (m === 12 || !covers(s, m + 1));
              return <td class:list={{ on, s: st, e: en }} style={on ? `--c:${s.color ?? 'var(--brand)'}` : undefined}><span class="sr-only">{on ? '●' : '—'}</span></td>;
            })}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</figure>
<style>
  .gc { margin: 32px 0; border: 1px solid var(--border); border-radius: 20px; background: var(--surface); overflow: hidden; box-shadow: var(--shadow-sm); }
  figcaption { padding: 16px 18px; font: 800 1.02rem/1.3 var(--font-head); border-bottom: 1px solid var(--border); }
  figcaption span { font-weight: 500; color: var(--text-3); }
  .gc__scroll { overflow-x: auto; padding: 8px 0 12px; }
  table { border-collapse: separate; border-spacing: 0 6px; width: 100%; min-width: 640px; font-size: .85rem; }
  th, td { padding: 4px 0; text-align: center; }
  thead th { font: 700 .7rem/1 var(--font-head); text-transform: uppercase; letter-spacing: .08em; color: var(--text-3); padding-bottom: 6px; }
  tbody th { text-align: left; padding: 0 16px; white-space: nowrap; font-weight: 600; position: sticky; left: 0; z-index: 1; background: var(--surface); }
  td { height: 34px; position: relative; background: linear-gradient(90deg, var(--border) 1px, transparent 1px) 0 0 / 100% 100% no-repeat; }
  td.on::before { content: ''; position: absolute; inset: 5px 0; background: var(--c); opacity: .9; }
  td.on.s::before { left: 3px; border-top-left-radius: 8px; border-bottom-left-radius: 8px; }
  td.on.e::before { right: 3px; border-top-right-radius: 8px; border-bottom-right-radius: 8px; }
</style>
