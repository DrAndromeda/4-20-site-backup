---
import type { Lang } from '../i18n/ui';
import { localePath, useTranslations } from '../i18n/utils';
import DisclaimerBanner from './DisclaimerBanner.astro';
interface Props { lang: Lang; showDisclaimer?: boolean }
const { lang, showDisclaimer = true } = Astro.props;
const t = useTranslations(lang);
---
<footer class="ftr">
  <div class="container">
    {showDisclaimer && <DisclaimerBanner lang={lang} />}
    <div class="ftr__row">
      <div>
        <a class="ftr__logo" href={localePath(lang)}>4·20</a>
        <p class="ftr__about">{t('footer.about')}</p>
      </div>
      <nav class="ftr__links" aria-label="Footer">
        <a href={localePath(lang, '/legal/')}>{t('footer.legal')}</a>
        <a href={localePath(lang, '/sources/')}>{t('footer.sources')}</a>
        <a href={localePath(lang, '/faq/')}>{t('nav.faq')}</a>
      </nav>
    </div>
    <p class="ftr__copy">© {new Date().getFullYear()} 4-20.com.ua. {t('footer.rights')}</p>
  </div>
</footer>
<style>
  .ftr { background: var(--bg-alt); border-top: 1px solid var(--border); padding-block: 24px 40px; margin-top: 0; }
  .ftr__row { display: flex; flex-wrap: wrap; gap: 24px; justify-content: space-between; align-items: flex-start; }
  .ftr__logo { font: 800 1.5rem/1 var(--font-head); color: var(--text); text-decoration: none; }
  .ftr__about { color: var(--text-2); margin: 8px 0 0; max-width: 40ch; }
  .ftr__links { display: flex; flex-wrap: wrap; gap: 4px 20px; }
  .ftr__links a { display: inline-flex; align-items: center; min-height: 44px; color: var(--link); text-decoration: underline; font-weight: 600; }
  .ftr__copy { margin: 24px 0 0; color: var(--text-2); font-size: .85rem; }
</style>
