---
/** Responsive table: real <table> on desktop, stacked label/value cards on mobile. Works without JS. */
interface Props { caption: string; columns: string[]; rows: string[][]; firstColHeader?: boolean }
const { caption, columns, rows } = Astro.props;
---
<div class="ct" role="region" aria-label={caption} tabindex="0">
  <table>
    <caption>{caption}</caption>
    <thead><tr>{columns.map((c) => <th scope="col">{c}</th>)}</tr></thead>
    <tbody>
      {rows.map((r) => (
        <tr>
          {r.map((cell, i) => (
            i === 0
              ? <th scope="row" data-label={columns[0]}>{cell}</th>
              : <td data-label={columns[i]}>{cell}</td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>
<style>
  .ct { margin-block: 28px; border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; background: var(--surface); }
  table { width: 100%; border-collapse: collapse; font-size: .95rem; }
  caption { text-align: left; padding: 14px 16px; font: 700 1rem/1.3 var(--font-head); border-bottom: 1px solid var(--border); }
  th, td { padding: 12px 16px; text-align: left; vertical-align: top; border-bottom: 1px solid var(--border); }
  thead th { background: var(--bg-alt); font: 700 .8rem/1.2 var(--font-head); letter-spacing: .06em; text-transform: uppercase; color: var(--text-2); }
  tbody th { font-weight: 700; }
  tbody tr:last-child > * { border-bottom: 0; }
  @media (max-width: 719px) {
    thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    table, tbody, tr, th, td { display: block; }
    tr { padding: 12px 16px; border-bottom: 1px solid var(--border); }
    tbody tr:last-child { border-bottom: 0; }
    th, td { padding: 4px 0; border: 0; }
    tbody th { font-size: 1.05rem; padding-bottom: 8px; }
    td[data-label]::before { content: attr(data-label); display: block; font: 700 .7rem/1.4 var(--font-head); letter-spacing: .08em; text-transform: uppercase; color: var(--text-2); }
    td { padding-bottom: 8px; }
  }
</style>
