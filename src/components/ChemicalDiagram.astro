---
/** Molecule card: name, formula, molar mass and an optional skeletal structure (`structure` prop = file in src/assets/structures, generated by scripts/gen-structures.py) or custom SVG via the default slot. */
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
const structures = import.meta.glob('../assets/structures/*.svg', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
interface Props { lang: Lang; name: string; formula: string; molarMass: string; caption?: string; /** 'thc' | 'cbd' | 'cbn' | 'cbg' (file in src/assets/structures) */ structure?: string }
const { lang, name, formula, molarMass, caption, structure } = Astro.props;
const svg = structure ? structures[`../assets/structures/${structure}.svg`] : undefined;
if (structure && !svg) throw new Error(`ChemicalDiagram: no structure file for "${structure}"`);
const t = useTranslations(lang);
const hasImage = !!svg || Astro.slots.has('default');
const sub = formula.replace(/(\d+)/g, '<sub>$1</sub>');
---
<figure class="cd">
  {hasImage && <div class="cd__img" role="img" aria-label={caption ?? name}>{svg ? <Fragment set:html={svg} /> : <slot />}</div>}
  <figcaption>
    <h3>{name}</h3>
    <dl>
      <div><dt>{t('ui.formula')}</dt><dd set:html={sub} /></div>
      <div><dt>{t('ui.molarMass')}</dt><dd>{molarMass} {t('ui.unit.gmol')}</dd></div>
    </dl>
  </figcaption>
</figure>
<style>
  .cd { margin: 28px 0; display: grid; gap: 0; grid-template-columns: minmax(0, 1fr); border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); overflow: hidden; max-width: 520px; }
  .cd__img :global(svg) { width: 100%; max-width: 420px; height: auto; }
  .cd__img { padding: 24px; background: #fff; display: grid; place-items: center; min-height: 180px; color: #1a1a2e; }
  figcaption { padding: 16px 20px; }
  .cd__img + figcaption { border-top: 1px solid var(--border); }
  figcaption h3 { margin: 0 0 8px; }
  dl { margin: 0; display: flex; gap: 24px; flex-wrap: wrap; }
  dt { font: 700 .72rem/1.4 var(--font-head); text-transform: uppercase; letter-spacing: .08em; color: var(--text-2); }
  dd { margin: 0; font-weight: 600; }
</style>
