---
interface Terpene { name: string; slug?: string; aroma: string; found: string; note?: string; color?: string }
import type { Lang } from '../i18n/ui';
import { localePath, useTranslations } from '../i18n/utils';
interface Props { lang: Lang; items: Terpene[] }
const { lang, items } = Astro.props;
const tr = useTranslations(lang);
---
<ul class="tg">
  {items.map((t) => (
    <li style={`--c:${t.color ?? 'var(--brand)'}`}>
      <span class="tg__dot" aria-hidden="true"></span>
      <h3>{t.slug ? <a class="tg__link" href={localePath(lang, '/terpenes/' + t.slug)}>{t.name}</a> : t.name}</h3>
      <p class="tg__aroma">{t.aroma}</p>
      <p class="tg__found">{t.found}</p>
      {t.note && <p class="tg__note">{t.note}</p>}
      {t.slug && <span class="card-link__go tg__go" aria-hidden="true"></span>}
    </li>
  ))}
</ul>
<style>
  .tg { list-style: none; margin: 32px 0; padding: 0; display: grid; gap: 14px; grid-template-columns: repeat(auto-fill, minmax(min(240px, 100%), 1fr)); }
  .tg li { position: relative; isolation: isolate; overflow: hidden; display: flex; flex-direction: column; padding: 22px; border: 1px solid var(--border); border-radius: 18px; background: var(--surface); }
  .tg li::before { content: ''; position: absolute; inset: 0; z-index: -1; background: radial-gradient(260px 160px at 100% 0%, color-mix(in srgb, var(--c) 18%, transparent), transparent 70%); }
  .tg li::after { content: ''; position: absolute; left: 22px; top: 0; width: 36px; height: 3px; border-radius: 0 0 3px 3px; background: var(--c); }
  .tg__dot { position: absolute; right: 18px; top: 18px; width: 12px; height: 12px; border-radius: 50%; background: var(--c); box-shadow: 0 0 0 4px color-mix(in srgb, var(--c) 20%, transparent); }
  .tg h3 { margin: 0 0 8px; }
  .tg li:has(.tg__link) { transition: transform .35s var(--ease), border-color .25s, box-shadow .35s var(--ease); box-shadow: var(--shadow-sm); }
  .tg li:has(.tg__link):hover { transform: translateY(-4px); border-color: color-mix(in srgb, var(--c) 60%, var(--border)); box-shadow: var(--shadow-lg); }
  .tg__link { color: var(--text); text-decoration: none; }
  .tg__link::after { content: ''; position: absolute; inset: 0; } /* whole card clickable */
  .tg li:has(.tg__link):hover .tg__go { color: var(--brand-ink); background: var(--brand); box-shadow: 0 6px 16px -4px color-mix(in srgb, var(--brand) 70%, transparent); }
  .tg li:has(.tg__link):hover .tg__go::before { transform: rotate(0); }
  .tg__go { top: 16px; right: 16px; }
  .tg li:has(.tg__link) .tg__dot { display: none; }
  .tg li:has(.tg__link) h3 { padding-right: 48px; }
  .tg p { margin: 0 0 6px; font-size: .92rem; }
  .tg__aroma { font-weight: 600; color: var(--text); }
  .tg__found, .tg__note { color: var(--text-2); }
</style>
