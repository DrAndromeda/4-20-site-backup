---
import { getCollection, render } from 'astro:content';
import Article from '../../layouts/Article.astro';
import ComparisonTable from '../../components/ComparisonTable.astro';
import TerpeneGrid from '../../components/TerpeneGrid.astro';
import GrowCalendar from '../../components/GrowCalendar.astro';
import ChemicalDiagram from '../../components/ChemicalDiagram.astro';
import PotencyCalculator from '../../components/PotencyCalculator.astro';
import { LOCALES, type Lang } from '../../i18n/ui';

export async function getStaticPaths() {
  const entries = await getCollection('pages', (e) => !e.data.draft);
  const byPath = new Map<string, Lang[]>();
  for (const e of entries) {
    const [lang, ...rest] = e.id.split('/');
    const slug = rest.join('/');
    byPath.set(slug, [...(byPath.get(slug) ?? []), lang as Lang]);
  }
  return entries.map((entry) => {
    const [lang, ...rest] = entry.id.split('/');
    const slug = rest.join('/');
    if (!(LOCALES as readonly string[]).includes(lang)) throw new Error(`Bad language folder in content id: ${entry.id}`);
    return {
      params: { lang, slug },
      props: { entry, langs: LOCALES.filter((l) => byPath.get(slug)?.includes(l)) },
    };
  });
}
const { entry, langs } = Astro.props;
const lang = Astro.params.lang as Lang;
const { Content, headings } = await render(entry);
const path = `/${Astro.params.slug}/`;
// Reading time from the MDX body + answer + FAQ: strip imports/components/markup, ~200 words per minute.
const text = [entry.body ?? '', entry.data.answer, ...entry.data.faq.flatMap((f) => [f.q, f.a])].join('\n');
const words = text.replace(/^import .*$/gm, '').replace(/<[^>]+>/g, ' ').replace(/[#*_>`|\[\]()-]/g, ' ').split(/\s+/).filter(Boolean).length;
const readMin = Math.max(1, Math.round(words / 200));
---
<Article lang={lang} path={path} data={entry.data} langs={langs} readMin={readMin} headings={headings.filter((h) => h.depth === 2)}><Content components={{ ComparisonTable, TerpeneGrid, GrowCalendar, ChemicalDiagram, PotencyCalculator }} /></Article>
