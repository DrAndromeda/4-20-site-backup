---
import '../styles/global.css';
import { LOCALES, LANG_META } from '../i18n/ui';
import Logo from '../components/Logo.astro';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>4-20</title>
    <meta name="robots" content="noindex,follow" />
    <link rel="canonical" href="https://4-20.com.ua/en/" />
    {LOCALES.map((l) => <link rel="alternate" hreflang={l} href={`https://4-20.com.ua/${l}/`} />)}
    <link rel="alternate" hreflang="x-default" href="https://4-20.com.ua/en/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>try{var t=localStorage.getItem('theme');if(t==='light'||t==='dark')document.documentElement.dataset.theme=t}catch(e){}</script>
    <noscript><meta http-equiv="refresh" content="3;url=/ru/" /></noscript>
  </head>
  <body class="pick">
    <main>
      <div class="pick__logo"><Logo href="/en/" size="lg" /></div>
      <ul>
        {LOCALES.map((l) => <li><a class="card-link pick__lang" href={`/${l}/`} hreflang={l} lang={l}><span class="pick__code">{LANG_META[l].label}</span>{LANG_META[l].name}<span class="card-link__go" aria-hidden="true"></span></a></li>)}
      </ul>
    </main>
    <script is:inline>
      try {
        var saved = localStorage.getItem('lang');
        var nav = (navigator.language || 'en').slice(0, 2).toLowerCase();
        var map = { ru: 'ru', uk: 'uk', en: 'en', es: 'es' };
        location.replace('/' + (map[saved] || map[nav] || 'en') + '/');
      } catch (e) {}
    </script>
  </body>
</html>
<style is:global>
  .pick { min-height: 100dvh; display: grid; place-items: center; padding: 24px; background: radial-gradient(600px 400px at 50% 0%, var(--glow), transparent 70%), var(--bg); }
  .pick main { width: min(360px, 100%); }
  .pick__logo { display: flex; justify-content: center; margin: 0 0 28px; }
  .pick ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  .pick__lang { flex-direction: row; align-items: center; gap: 14px; padding: 16px 18px; font: 700 1.05rem/1 var(--font-head); }
  .pick__lang .card-link__go { top: 50%; margin-top: -18px; right: 14px; }
  .pick__code { width: 34px; height: 34px; display: grid; place-items: center; border-radius: 10px; background: var(--bg-alt); border: 1px solid var(--border); font: 700 .75rem/1 var(--font-mono); color: var(--text-2); }
</style>
